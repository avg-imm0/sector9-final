[sub_resource type="Shader" id="Shader_ink"]
code = "shader_type canvas_item;

uniform float strength : hint_range(0.0, 1.0) = 0.72;
uniform float scanlines : hint_range(0.0, 0.05) = 0.011;
uniform float grain : hint_range(0.0, 0.15) = 0.038;

float hash(vec2 p) {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

void fragment() {
	vec2 uv = UV - 0.5;
	float d = length(uv * vec2(1.0, 0.92));
	float v = smoothstep(0.31, 0.82, d) * strength;

	float n = hash(floor(UV * vec2(920.0, 700.0)) + vec2(fract(TIME * 0.37) * 17.0, fract(TIME * 0.53) * 23.0)) - 0.5;
	float fiber = (sin(UV.x * 420.0 + sin(UV.y * 57.0) * 3.1) * 0.5 + 0.5) * 0.008;
	float scan = (0.5 + 0.5 * sin(UV.y * 1100.0)) * scanlines;

	float alpha = clamp(v + scan + abs(n) * grain + fiber, 0.0, 0.96);
	COLOR = vec4(vec3(0.012, 0.009, 0.007), alpha);
}
"

